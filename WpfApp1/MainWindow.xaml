<Window x:Class="PasswordGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        mc:Ignorable="d"
        Title="PasswordGenerator" Width="280" SizeToContent="WidthAndHeight" Height="150">
    <Grid>

        <Button Content="Generate" HorizontalAlignment="Left" Margin="20,85,0,0" VerticalAlignment="Top" Width="70" Height="20" FontFamily="NSimSun" FontSize="14" Click="Button_Click"/>
        <TextBox Name="Textbox" Margin="20,20,60,94" TextWrapping="Wrap" Width="200" FontFamily="NSimSun" FontSize="14" Height="20"/>
        <Slider x:Name="Slider" HorizontalAlignment="Left" Margin="133,57,0,0" VerticalAlignment="Top" Width="120" AutoToolTipPlacement="TopLeft" Minimum="15" Maximum="25" SmallChange="1" LargeChange="5" Value="15"/>
        <Label Content="Password lenght :" HorizontalAlignment="Left" Margin="20,53,0,0" VerticalAlignment="Top" Width="110" Height="24" FontFamily="NSimSun"/>

    </Grid>
</Window>
